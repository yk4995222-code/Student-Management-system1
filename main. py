import json
import os

FILE_NAME = "students.json"


def load_students():
    """Load student records from a JSON file."""
    if not os.path.exists(FILE_NAME):
        return []

    try:
        with open(FILE_NAME, "r", encoding="utf-8") as file:
            return json.load(file)
    except (json.JSONDecodeError, OSError):
        print("Warning: Could not read student records.")
        return []


def save_students(students):
    """Save student records to a JSON file."""
    with open(FILE_NAME, "w", encoding="utf-8") as file:
        json.dump(students, file, indent=4)


def add_student(students):
    student_id = input("Enter student ID: ").strip()

    if not student_id:
        print("Student ID cannot be empty.")
        return

    if any(s["id"] == student_id for s in students):
        print("This student ID already exists.")
        return

    name = input("Enter student name: ").strip()

    if not name:
        print("Name cannot be empty.")
        return

    try:
        marks = float(input("Enter marks (0-100): "))
        if not 0 <= marks <= 100:
            raise ValueError
    except ValueError:
        print("Please enter valid marks between 0 and 100.")
        return

    students.append({
        "id": student_id,
        "name": name,
        "marks": marks
    })

    save_students(students)
    print("Student added successfully!")


def view_students(students):
    if not students:
        print("No student records found.")
        return

    for student in students:
        print(
            f'ID: {student["id"]} | '
            f'Name: {student["name"]} | '
            f'Marks: {student["marks"]}'
        )


def search_student(students):
    student_id = input("Enter student ID to search: ").strip()

    for student in students:
        if student["id"] == student_id:
            print(student)
            return

    print("Student not found.")


def update_student(students):
    student_id = input("Enter student ID to update: ").strip()

    for student in students:
        if student["id"] == student_id:
            name = input("New name (Enter to keep current): ").strip()
            if name:
                student["name"] = name

            marks = input("New marks (Enter to keep current): ").strip()
            if marks:
                try:
                    value = float(marks)
                    if not 0 <= value <= 100:
                        raise ValueError
                    student["marks"] = value
                except ValueError:
                    print("Invalid marks. Update cancelled.")
                    return

            save_students(students)
            print("Student updated successfully!")
            return

    print("Student not found.")


def delete_student(students):
    student_id = input("Enter student ID to delete: ").strip()

    for student in students:
        if student["id"] == student_id:
            students.remove(student)
            save_students(students)
            print("Student deleted successfully!")
            return

    print("Student not found.")


def main():
    students = load_students()

    while True:
        print("\n=== Student Management System ===")
        print("1. Add student")
        print("2. View students")
        print("3. Search student")
        print("4. Update student")
        print("5. Delete student")
        print("6. Exit")

        choice = input("Choose an option: ").strip()

        if choice == "1":
            add_student(students)
        elif choice == "2":
            view_students(students)
        elif choice == "3":
            search_student(students)
        elif choice == "4":
            update_student(students)
        elif choice == "5":
            delete_student(students)
        elif choice == "6":
            print("Goodbye!")
            break
        else:
            print("Invalid option. Choose 1-6.")


if __name__ == "__main__":
    main()